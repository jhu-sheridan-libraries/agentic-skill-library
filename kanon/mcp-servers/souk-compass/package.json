{
	"name": "@stevenjmiklovic/solrcompass",
	"version": "0.1.0",
	"description": "Bun-powered Solr semantic search, codebase retrieval, and memory MCP server",
	"type": "module",
	"bin": {
		"solrcompass": "./bridge/mcp-server.mjs"
	},
	"files": [
		"README.md",
		"LICENSE",
		"bridge/mcp-server.mjs",
		"docker-compose.yml",
		"solr/configset/**",
		"solr/schema.xml",
		"solr/README.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "bun x tsc --noEmit",
		"build": "bun build src/index.ts --target=bun --outfile=bridge/mcp-server.mjs --format=esm --external @xenova/transformers --external @aws-sdk/*",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepack": "bun run build",
		"prepublishOnly": "bun test && bun run lint && bun run build"
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "3.1106.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@xenova/transformers": "2.17.2",
		"gray-matter": "4.0.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "1.3.14",
		"fast-check": "4.9.0",
		"typescript": "7.0.2"
	},
	"keywords": [
		"mcp",
		"solr",
		"semantic-search",
		"vector-search",
		"codebase-search",
		"bun"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/thinkingsage/context-bazaar.git",
		"directory": "kanon/mcp-servers/souk-compass"
	},
	"homepage": "https://github.com/thinkingsage/context-bazaar/tree/main/kanon/mcp-servers/souk-compass",
	"bugs": {
		"url": "https://github.com/thinkingsage/context-bazaar/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
