{
	"files": {
		"includes": [
			"src/**",
			"mcp-servers/*/src/**",
			"scripts/**",
			"evals/**",
			"collections/**",
			"package.json",
			"tsconfig.json",
			"bunfig.toml"
		]
	},
	"overrides": [
		{
			"includes": ["src/__tests__/**", "mcp-servers/*/src/__tests__/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noTemplateCurlyInString": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	]
}
